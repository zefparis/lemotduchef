{
  "name": "lemotduchef-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API Le Mot du Chef — Fastify + PostgreSQL, sessions serveur, isolation par restaurant",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "llm:sample": "tsx scripts/llm-sample.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "better-auth": "^1.7.11",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "stripe": "^23.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
