# ── Le Mot du Chef · API (server/) ─────────────────────────────
# Copier en .env sur x3 et adapter. Ne jamais versionner .env.

# Port d'écoute dans le conteneur (mappé sur 127.0.0.1:API_PORT par Compose)
PORT=3500

# Origines frontend autorisées en CORS (credentials), séparées par des virgules.
# Prod : https://lemotduchef.fr,https://www.lemotduchef.fr,https://za.lemotduchef.fr
CORS_ORIGINS=https://lemotduchef.fr,https://www.lemotduchef.fr,https://za.lemotduchef.fr

# SameSite du cookie de session.
# - lax (défaut) : front lemotduchef.fr/www + api.lemotduchef.fr = même site.
# - none : uniquement pour tests cross-site (ex. *.vercel.app) — peut être
#   bloqué comme cookie tiers par Safari/Firefox. Exige Secure/HTTPS.
COOKIE_SAMESITE=lax
# Attribut Domain du cookie : VIDE par défaut (host-only sur api.lemotduchef.fr).
COOKIE_DOMAIN=

# Origine publique de l'API (base URL Better Auth + cookie Secure si https)
BASE_URL=https://api.lemotduchef.fr

# Secret session : openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_secret_aleatoire_32_octets_minimum

# Chaîne PostgreSQL (fournie par docker-compose en pratique)
DATABASE_URL=postgres://lemotduchef:CHANGE_ME@db:5432/lemotduchef

# Inscription publique. La vérification d'email est obligatoire : sans SMTP,
# l'inscription est refusée même si SIGNUP_ENABLED=true.
# L'interrupteur du back-office (base) est prioritaire sur cette valeur.
SIGNUP_ENABLED=false

# Back-office (/admin) : emails autorisés à administrer, séparés par des
# virgules. Seule source du rôle administrateur — jamais exposée au front.
ADMIN_EMAILS=exploitant@exemple.fr

# Anti-abus : requêtes /api/auth/* et générations LLM par IP et par minute.
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_GENERATE_MAX=20

# Emails transactionnels (vérification 24 h, reset 1 h). Requis en prod.
# SMTP_HOST=log → mode test : emails journalisés, aucun envoi réel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Le Mot du Chef <noreply@lemotduchef.fr>

# Origine publique du frontend pour les liens des emails.
# Défaut : 1re origine de CORS_ORIGINS.
FRONT_URL=https://lemotduchef.fr

# Rédacteur LLM — appels côté serveur uniquement, clé jamais exposée.
# anthropic en prod ; mock uniquement en dev/tests (refusé en production).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_TIMEOUT_MS=40000
LLM_MAX_OUTPUT_TOKENS=1200

# Offre Gratuit : générations par mois civil et par restaurant (3 variantes
# par génération) ; profondeur d'historique en jours (Pro : complet).
FREE_MONTHLY_REPLIES=5
FREE_HISTORY_DAYS=30

# RGPD : texte de l'avis et prénom d'auteur effacés N mois après la saisie
# (0 = jamais).
REVIEW_RETENTION_MONTHS=12

# Abonnement Stripe (sk_test_* en test). Sans clé : facturation désactivée.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PORTAL_RETURN_URL=https://lemotduchef.fr
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# Marché ZA — compléments de public/markets.js (source unique de la config
# par marché). za.lemotduchef.fr : même API et mêmes boîtes email que FR.
# ZA_DOMAINS : domaines supplémentaires (préprod, tests, futur .co.za).
ZA_DOMAINS=
# Paiement ZA : Paystack en priorité, Stripe ZA si le compte l'ouvre.
PAYSTACK_ZA_SECRET_KEY=
PAYSTACK_ZA_PUBLIC_KEY=
PAYSTACK_ZA_PLAN_MONTHLY=
PAYSTACK_ZA_PLAN_YEARLY=
STRIPE_ZA_SECRET_KEY=
STRIPE_ZA_WEBHOOK_SECRET=
STRIPE_ZA_PRICE_PRO_MONTHLY=
STRIPE_ZA_PRICE_PRO_YEARLY=

# cloudflared sur l'hôte → X-Forwarded-* fiables. Laisser true.
TRUST_PROXY=true

# Forcer le cookie Secure hors https (auto si BASE_URL https).
COOKIE_SECURE=true

LOG_LEVEL=info
