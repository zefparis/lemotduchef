# ── Le Mot du Chef · configuration ─────────────────────────────
# Copier en .env et remplacer les valeurs. Ne jamais versionner .env.
# Ce fichier couvre deux usages : le build frontend (Vercel) et la
# stack Docker Compose (X3, voir DEPLOIEMENT-X3.md).

# ── Frontend (Vercel) ──────────────────────────────────────────
# URL publique de l'API (backend X3 derrière le tunnel Cloudflare).
VITE_API_URL=https://api.lemotduchef.fr

# Informations légales injectées dans les pages /mentions-legales, /cgv et
# /confidentialite au moment du build (aucune donnée en dur dans le HTML).
# Toutes OBLIGATOIRES : le build échoue en production si l'une manque.
LEGAL_NAME=Prénom NOM, entrepreneur individuel — ENSEIGNE
LEGAL_SIREN=000000000
LEGAL_RCS=RCS Ville
LEGAL_ADDRESS=Adresse postale complète
LEGAL_EMAIL=contact@lemotduchef.fr
LEGAL_VAT_MENTION=TVA non applicable, art. 293 B du CGI
LEGAL_PUBLISHER=Prénom NOM

# ── Stack Docker Compose (X3) ──────────────────────────────────
# PostgreSQL (reste privé au réseau Docker)
POSTGRES_DB=lemotduchef
POSTGRES_USER=lemotduchef
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_long_et_aleatoire

# Secret de session Better Auth : openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_secret_aleatoire_32_octets_minimum

# Origine publique de l'API servie (https://api.lemotduchef.fr en prod)
# - détermine le cookie Secure (https → Secure)
# - et les origines de confiance Better Auth / CSRF.
BASE_URL=http://127.0.0.1:3500

# Origines frontend autorisées (CORS + credentials), séparées par des
# virgules. Ex. : https://lemotduchef.fr,https://www.lemotduchef.fr
# Vide = front servi par l'API (même origine, pas de CORS nécessaire).
CORS_ORIGINS=https://lemotduchef.fr,https://www.lemotduchef.fr

# Cookie de session.
# - Prod : front https://lemotduchef.fr + API https://api.lemotduchef.fr =
#   MÊME site → lax (recommandé ; 'none' serait bloqué comme cookie tiers
#   par Safari/Firefox).
# - COOKIE_DOMAIN : laisser VIDE (cookie host-only sur api.lemotduchef.fr).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Port hôte (loopback uniquement) où cloudflared vient chercher l'app.
# 3400 est déjà pris sur X3 → 3500. Vérifier : ss -tln | grep 3500
API_PORT=3500

# Inscription publique. La vérification d'email est obligatoire : sans SMTP
# configuré, l'inscription est refusée (503) même si SIGNUP_ENABLED=true.
# L'interrupteur du back-office (base) est prioritaire sur cette valeur.
SIGNUP_ENABLED=false

# Back-office (/admin) : emails autorisés à administrer, séparés par des
# virgules. Aucun autre moyen de devenir administrateur.
ADMIN_EMAILS=exploitant@exemple.fr

# Anti-abus : requêtes /api/auth/* et générations LLM par IP et par minute.
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_GENERATE_MAX=20

# ── Emails transactionnels (vérification, mot de passe oublié) ──
# Serveur SMTP de votre choix (Brevo, Mailjet, Resend via SMTP, OVH…).
# Sans SMTP_HOST, aucun email ne part et l'inscription publique est refusée.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Le Mot du Chef <noreply@lemotduchef.fr>

# Origine publique du frontend : les liens des emails (vérification,
# réinitialisation) pointent vers elle. Défaut : 1re origine de CORS_ORIGINS.
FRONT_URL=https://lemotduchef.fr

# ── Rédacteur LLM (côté serveur uniquement) ────────────────────
# anthropic en production ; mock = développement local/tests uniquement
# (refusé en production).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_TIMEOUT_MS=40000
LLM_MAX_OUTPUT_TOKENS=1200

# ── Offres ─────────────────────────────────────────────────────
# Gratuit : générations de réponses par mois civil et par restaurant
# (1 génération = 3 variantes), sans carte. Appliqué côté serveur.
FREE_MONTHLY_REPLIES=5
# Gratuit : profondeur d'historique consultable (jours). Pro : complet.
FREE_HISTORY_DAYS=30

# ── RGPD ───────────────────────────────────────────────────────
# Texte de l'avis et prénom de l'auteur effacés N mois après la saisie
# (0 = jamais). Mentionné dans la politique de confidentialité.
REVIEW_RETENTION_MONTHS=12

# ── Abonnement Stripe ──
# Clés sk_test_* pour la préproduction, sk_live_* en production.
# Sans STRIPE_SECRET_KEY la facturation est désactivée (enabled:false).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...          # « Signing secret » du webhook dashboard
STRIPE_PORTAL_RETURN_URL=https://lemotduchef.fr
# Price IDs des offres (dashboard Stripe → Produits). Aucun montant en dur :
# les prix affichés sont relus depuis l'API Stripe.
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# true derrière cloudflared (en-têtes X-Forwarded-* honorés).
TRUST_PROXY=true

LOG_LEVEL=info
